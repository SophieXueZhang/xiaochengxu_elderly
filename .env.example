# 永伴 AI 环境配置示例

# 应用配置
APP_NAME=永伴 AI
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars

# 服务器配置
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS配置
BACKEND_CORS_ORIGINS=*

# 数据库配置
POSTGRES_HOST=yongban-db
POSTGRES_PORT=5432
POSTGRES_USER=yongban
POSTGRES_PASSWORD=yongban_password_change_me
POSTGRES_DB=yongban

# Redis配置
REDIS_HOST=yongban-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant向量数据库配置
QDRANT_HOST=yongban-qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=user_memories

# MinIO/S3配置
MINIO_ENDPOINT=yongban-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET=yongban
MINIO_SECURE=false

# OpenAI配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Azure OpenAI配置（可选）
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=sk-your-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT=

# Anthropic配置（备选）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Stability AI配置
STABILITY_API_KEY=sk-your-stability-api-key-here
STABILITY_ENGINE=stable-diffusion-xl-1024-v1-0

# ElevenLabs配置
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_MODEL=eleven_multilingual_v2

# Azure Speech配置（备选）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 业务配置
MAX_FREE_MESSAGES_PER_DAY=20
MAX_PREMIUM_MESSAGES_PER_DAY=500
MAX_COMPANIONS_FREE=1
MAX_COMPANIONS_PREMIUM=5
MAX_VOICE_DURATION_SECONDS=60
MAX_UPLOAD_SIZE=10485760

# Celery配置
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/yongban.log

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090
