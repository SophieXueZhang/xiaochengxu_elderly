<!--pages/register/register.wxml-->
<view class="page">
  <view class="container">
    <!-- Logo区域 -->
    <view class="logo">
      <text class="logo-title">永伴</text>
      <text class="logo-subtitle">注册新账号</text>
    </view>

    <!-- 注册表单 -->
    <view class="card">
      <view class="page-title">注册</view>

      <view class="form-group">
        <text class="form-label">手机号</text>
        <input
          class="input-large"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-class="input-placeholder"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="form-group">
        <text class="form-label">昵称</text>
        <input
          class="input-large"
          type="text"
          placeholder="请输入昵称"
          placeholder-class="input-placeholder"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="form-group">
        <text class="form-label">密码</text>
        <input
          class="input-large"
          type="password"
          placeholder="至少6位密码"
          placeholder-class="input-placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <view class="form-group">
        <text class="form-label">确认密码</text>
        <input
          class="input-large"
          type="password"
          placeholder="请再次输入密码"
          placeholder-class="input-placeholder"
          value="{{password2}}"
          bindinput="onPassword2Input"
        />
      </view>

      <button
        class="btn btn-primary btn-large"
        bindtap="handleRegister"
        disabled="{{loading}}"
      >
        {{loading ? '注册中...' : '立即注册'}}
      </button>

      <view class="divider">
        <text>已有账号？</text>
      </view>

      <button
        class="btn btn-secondary btn-large"
        bindtap="goToLogin"
      >
        返回登录
      </button>
    </view>
  </view>
</view>
