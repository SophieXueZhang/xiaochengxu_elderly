<!--pages/login/login.wxml-->
<view class="page">
  <view class="container">
    <!-- Logo区域 -->
    <view class="logo">
      <text class="logo-title">永伴</text>
      <text class="logo-subtitle">陪您聊天的智能伙伴</text>
    </view>

    <!-- 登录表单 -->
    <view class="card">
      <view class="page-title">登录</view>

      <view class="form-group">
        <text class="form-label">手机号</text>
        <input
          class="input-large"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-class="input-placeholder"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="form-group">
        <text class="form-label">密码</text>
        <input
          class="input-large"
          type="password"
          placeholder="请输入密码"
          placeholder-class="input-placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <button
        class="btn btn-primary btn-large"
        bindtap="handleLogin"
        disabled="{{loading}}"
      >
        {{loading ? '登录中...' : '登录'}}
      </button>

      <view class="divider">
        <text>还没有账号？</text>
      </view>

      <button
        class="btn btn-secondary btn-large"
        bindtap="goToRegister"
      >
        注册新账号
      </button>
    </view>

    <!-- 测试账号提示 -->
    <view class="test-hint">
      <text class="test-hint-text">测试账号：13800138000</text>
      <text class="test-hint-text">测试密码：password123</text>
    </view>
  </view>
</view>
