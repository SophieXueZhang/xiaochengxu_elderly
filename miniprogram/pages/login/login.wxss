/* pages/login/login.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.container {
  padding-top: 100rpx;
}

.logo {
  text-align: center;
  padding: 60rpx 0;
}

.logo-title {
  display: block;
  font-size: 88rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.logo-subtitle {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

.card {
  margin: 0 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.page-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 50rpx;
  text-align: center;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.input-large {
  width: 100%;
  height: 90rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  border: 2rpx solid #E1E4E8;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #F5F7FA;
}

.input-placeholder {
  color: #999;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #E1E4E8;
}

.divider text {
  padding: 0 20rpx;
}

.test-hint {
  margin-top: 60rpx;
  padding: 30rpx;
  text-align: center;
}

.test-hint-text {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.8;
}
