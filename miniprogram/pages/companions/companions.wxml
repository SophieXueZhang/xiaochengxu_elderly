<!--pages/companions/companions.wxml-->
<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="welcome-info">
      <text class="welcome-text">您好，{{nickname}}</text>
      <text class="welcome-subtitle">选择陪伴角色开始聊天</text>
    </view>
    <view class="logout-btn" bindtap="handleLogout">
      <text>退出</text>
    </view>
  </view>

  <!-- 角色列表 -->
  <view class="container">
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{companions.length === 0}}" class="empty-state">
      <text class="empty-icon">👤</text>
      <text class="empty-text">还没有陪伴角色</text>
      <text class="empty-hint">点击下方按钮创建您的第一个陪伴角色</text>
    </view>

    <!-- 角色卡片列表 -->
    <view wx:else class="companions-list">
      <view
        wx:for="{{companions}}"
        wx:key="id"
        class="companion-card"
        bindtap="goToChat"
        data-companion="{{item}}"
      >
        <view class="companion-avatar">
          <text class="avatar-text">{{item.name.charAt(0)}}</text>
        </view>
        <view class="companion-info">
          <view class="companion-name">{{item.name}}</view>
          <view class="companion-meta">
            <text class="companion-relationship">{{item.relationshipText}}</text>
            <text class="companion-dot">·</text>
            <text class="companion-gender">{{item.genderText}}</text>
          </view>
          <view class="companion-story" wx:if="{{item.background_story}}">
            {{item.background_story}}
          </view>
        </view>
        <view class="companion-arrow">
          <text>›</text>
        </view>
      </view>
    </view>

    <!-- 创建按钮 -->
    <view class="create-btn-container">
      <button class="btn btn-primary btn-large btn-create" bindtap="goToCreate">
        ＋ 创建新的陪伴角色
      </button>
    </view>
  </view>
</view>
