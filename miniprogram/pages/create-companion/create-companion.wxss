/* pages/create-companion/create-companion.wxss */

.page {
  min-height: 100vh;
  background: #F5F7FA;
}

.container {
  padding: 40rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.page-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 50rpx;
  text-align: center;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.input-large {
  width: 100%;
  height: 90rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  border: 2rpx solid #E1E4E8;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #F5F7FA;
}

.input-placeholder {
  color: #999;
}

.picker-view {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  border: 2rpx solid #E1E4E8;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #F5F7FA;
  color: #333;
}

.textarea-large {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx 30rpx;
  font-size: 32rpx;
  border: 2rpx solid #E1E4E8;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #F5F7FA;
  line-height: 1.6;
}

.char-count {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-align: right;
}
