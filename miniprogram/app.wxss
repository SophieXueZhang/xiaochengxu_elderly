/**app.wxss**/
/* 全局样式 - 适配老年人使用习惯 */

page {
  background-color: #F5F7FA;
  font-family: -apple-system-font, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 32rpx; /* 更大的基础字号，方便老年人阅读 */
  line-height: 1.6;
  color: #333;
}

/* 容器 */
.container {
  padding: 40rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 按钮样式 */
.btn {
  border: none;
  border-radius: 16rpx;
  font-size: 36rpx; /* 大字号按钮 */
  font-weight: 500;
  text-align: center;
  padding: 28rpx 40rpx;
  margin: 20rpx 0;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background: #fff;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
}

.btn-large {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
}

.btn-disabled {
  opacity: 0.5;
}

/* 表单组件 */
.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.input-large {
  width: 100%;
  height: 90rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  border: 2rpx solid #E1E4E8;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fff;
}

.input-large:focus {
  border-color: #4A90E2;
}

.textarea-large {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx 30rpx;
  font-size: 32rpx;
  border: 2rpx solid #E1E4E8;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fff;
  line-height: 1.6;
}

/* 页面标题 */
.page-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 40rpx;
  text-align: center;
}

/* Logo区域 */
.logo {
  text-align: center;
  padding: 80rpx 0 60rpx;
}

.logo-title {
  font-size: 80rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-bottom: 20rpx;
}

.logo-subtitle {
  font-size: 32rpx;
  color: #666;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #E1E4E8;
}

.divider text {
  padding: 0 20rpx;
}

/* 加载提示 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #ccc;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

/* 工具类 */
.text-center {
  text-align: center;
}

.text-muted {
  color: #999;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.p-20 {
  padding: 20rpx;
}

/* 辅助功能 - 高对比度文字 */
.text-high-contrast {
  color: #000;
  font-weight: 500;
}
