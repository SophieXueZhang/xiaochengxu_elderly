/* components/image-message/image-message.wxss */

.image-message {
  max-width: 500rpx;
  margin: 10rpx 0;
}

.align-left {
  align-self: flex-start;
}

.align-right {
  align-self: flex-end;
}

.message-image {
  width: 100%;
  max-height: 600rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.caption {
  margin-top: 12rpx;
  padding: 20rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 8rpx;
}

.caption text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}
