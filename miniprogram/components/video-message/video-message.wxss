/* components/video-message/video-message.wxss */

.video-message {
  max-width: 500rpx;
  margin: 10rpx 0;
}

.align-left {
  align-self: flex-start;
}

.align-right {
  align-self: flex-end;
}

.video-player {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  background: #000;
}

.video-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
  padding: 0 10rpx;
}

.duration,
.size {
  font-size: 24rpx;
  color: #999;
}

.caption {
  margin-top: 12rpx;
  padding: 20rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 8rpx;
}

.caption text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}
